{
  "expo": {
    "name": "Emunah — אמונה",
    "slug": "emunah-jewish-wisdom",
    "version": "1.0.0",
    "description": "Sagesse juive au quotidien — citations, prières, calendrier hébraïque et méditations de la Torah.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emunah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#080A12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emunah.jewishwisdom",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Emunah n'utilise pas le microphone.",
        "CFBundleDisplayName": "Emunah",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.emunah.jewishwisdom",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080A12"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#080A12",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/emunah-jewish-wisdom"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73f7eaa9-eba9-446b-9df7-1687ca8b5d26"
      }
    },
    "owner": "charif759491",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/73f7eaa9-eba9-446b-9df7-1687ca8b5d26"
    }
  }
}
